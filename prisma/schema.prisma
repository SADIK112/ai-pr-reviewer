// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum PRStatus {
  OPEN
  CLOSED
  MERGED
}

enum SuggestionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SuggestionType {
  PERFORMANCE
  SECURITY
  STYLE
  BUG
  BEST_PRACTICE
  REFACTOR
  MAINTAINABILITY
  DOCUMENTATION
}

model Repository {
  id            String        @id @default(cuid())
  repoId        String        @unique
  userId        String
  owner         String
  name          String
  fullName      String
  description   String?
  isPrivate     Boolean       @default(false)
  htmlUrl       String
  webhookId     String?       @unique
  webhookSecret String?
  isActive      Boolean       @default(false)
  prsReviewed   Int           @default(0)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  pullRequests  PullRequest[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lastReviewed  DateTime?

  @@unique([userId, owner, name])
  @@index([userId])
  @@index([isActive])
  @@map("repositories")
}

model PullRequest {
  id                 String     @id @default(uuid())
  prNumber           Int
  prId               String     @unique
  nodeId             String     @unique
  title              String
  body               String?
  state              String
  url                String
  author             String?
  assignee           String?
  assignees          String[]   @default([])
  requestedReviewers String[]   @default([])
  comments           Int        @default(0)
  reviewComments     Int        @default(0)
  commits            Int        @default(0)
  additions          Int        @default(0)
  deletions          Int        @default(0)
  changedFiles       Int        @default(0)
  createdAtGithub    DateTime
  updatedAtGithub    DateTime
  closedAt           DateTime?
  mergedAt           DateTime?
  repositoryId       String
  repository         Repository @relation(fields: [repositoryId], references: [repoId])
  reviews            Review[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([repositoryId, prNumber])
  @@index([prNumber])
  @@index([repositoryId])
}

model Review {
  id               String       @id @default(uuid())
  summary          String       @db.Text
  complexityScore  Float?
  totalSuggestions Int          @default(0)
  criticalIssues   Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  pullRequestId    String
  pullRequest      PullRequest  @relation(fields: [pullRequestId], references: [prId], onDelete: Cascade)
  suggestions      Suggestion[]

  @@index([pullRequestId])
}

model Suggestion {
  id            String             @id @default(uuid())
  type          SuggestionType
  severity      SuggestionSeverity
  title         String
  description   String             @db.Text
  filePath      String
  lineNumber    Int?
  lineEnd       Int?
  codeSnippet   String?            @db.Text
  suggestedCode String?            @db.Text
  reviewId      String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  review        Review             @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([severity])
  @@index([filePath])
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  githubId      String?      @unique
  repoUrl       String?
  accounts      Account[]
  sessions      Session[]
  repositories  Repository[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
